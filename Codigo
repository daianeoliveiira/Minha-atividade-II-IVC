function dados = encontrarCranioSemOlhos()
clc; close all;

im = imread('mri-head_960_720.png');
imgray = im;
if size(im,3) == 3, imgray = rgb2gray(im); end

imgNorm = mat2gray(imgray);
imgFilt = imgaussfilt(imgNorm, 3);
imUint8 = im2uint8(imgNorm);
[linhas, colunas] = size(imgFilt);
[X, Y] = meshgrid(1:colunas, 1:linhas);

[accum, circen, cirrad] = CircularHough_Grd(imUint8, [15 60], 10, 20);
if size(circen,1) > 2
    pontuacao = zeros(size(circen,1),1);
    for k = 1:size(circen,1)
        x = round(circen(k,1)); y = round(circen(k,2));
        if x >= 1 && x <= size(accum,2) && y >= 1 && y <= size(accum,1)
            pontuacao(k) = accum(y,x);
        end
    end
    [~, ordem] = sort(pontuacao, 'descend');
    circen = circen(ordem(1:2),:);
    cirrad = cirrad(ordem(1:2));
end

mascSemOlhos = true(linhas, colunas);
for k = 1:size(circen,1)
    mascSemOlhos = mascSemOlhos & ~(((X-circen(k,1)).^2 + (Y-circen(k,2)).^2) <= (cirrad(k)*1.3)^2);
end

BWcranio = imbinarize(imgFilt, graythresh(imgFilt)*0.6) & mascSemOlhos;
BWcranio = bwareafilt(imfill(imclose(bwareaopen(BWcranio,2000),strel('disk',15)),'holes'),1);

props    = regionprops(BWcranio, 'Centroid', 'BoundingBox');
centroBase = props(1).Centroid;
raioCranio = min(props(1).BoundingBox(3:4)) / 2;

mascCircular = ((X-centroBase(1)).^2 + (Y-centroBase(2)).^2) <= (raioCranio*1.15)^2;

valoresDentro = imgFilt(mascCircular);
BW = imgFilt >= prctile(valoresDentro,50) & mascCircular & mascSemOlhos;
BW = imerode(bwareafilt(imfill(imclose(bwareaopen(BW,500),strel('disk',12)),'holes'),1),strel('disk',1));

props_todas = regionprops(BW,'Centroid','Area','Circularity','PixelIdxList');
for k = 1:length(props_todas)
    cx = props_todas(k).Centroid(1); cy = props_todas(k).Centroid(2);
    if props_todas(k).Area < 8000 && props_todas(k).Circularity > 0.75 && ...
            sqrt((cx-centroBase(1))^2+(cy-centroBase(2))^2) > raioCranio*0.55
        BW(props_todas(k).PixelIdxList) = 0;
    end
end
BW = bwareafilt(imfill(imclose(BW,strel('disk',8)),'holes'),1);

pe     = regionprops(BW,'Centroid','MajorAxisLength','MinorAxisLength','Orientation');
centro = pe(1).Centroid;
a      = (pe(1).MajorAxisLength/2) * 0.97;
b      = (pe(1).MinorAxisLength/2) * 1.0;
ang    = deg2rad(-pe(1).Orientation);
t      = linspace(0,2*pi,400);
xEl    = centro(1) + a*cos(t)*cos(ang) - b*sin(t)*sin(ang);
yEl    = centro(2) + a*cos(t)*sin(ang) + b*sin(t)*cos(ang);

figure(1);
imshow(imgNorm,[]); hold on;
plot(xEl, yEl, 'b-', 'LineWidth', 2.5);
plot(centro(1), centro(2), 'r+', 'MarkerSize', 14, 'LineWidth', 2);
for k = 1:size(circen,1)
    t = linspace(0,2*pi,400);
    plot(circen(k,1)+cirrad(k)*cos(t), circen(k,2)+cirrad(k)*sin(t), 'b-', 'LineWidth', 2.5);
    plot(circen(k,1), circen(k,2), 'r+', 'MarkerSize', 10, 'LineWidth', 2);
end
title('Crânio e globos oculares'); hold off;

dados.centroRegiao  = centro;
dados.eixoMaior     = a;
dados.eixoMenor     = b;
dados.anguloElipse  = ang;
dados.mascaraRegiao = BW;
dados.mascaraCranio = BWcranio;
dados.xElipse       = xEl;
dados.yElipse       = yEl;
dados.centrosOlhos  = circen;
dados.raiosOlhos    = cirrad;
dados.acumulador    = accum;
end
